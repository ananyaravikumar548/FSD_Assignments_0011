<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= child.firstName %> · Family Management</title><link rel="stylesheet" href="/styles.css"></head>
<body><main class="shell narrow"><a class="back-link" href="/users/<%= user._id %>">← Back to <%= user.firstName %>'s profile</a><section class="panel child-detail"><div class="child-avatar detail-avatar"><%= child.firstName.charAt(0).toUpperCase() %></div><p class="eyebrow">Child profile</p><h1><%= child.firstName %> <%= child.lastName %></h1><p class="muted"><%= child.age %> years old</p><a href="mailto:<%= child.email %>"><%= child.email %></a><p class="muted parent-note">Parent: <%= user.firstName %> <%= user.lastName %></p></section></main></body></html>
